DirectoryIndex index.html index.php

# ========== ОСНОВНЫЕ НАСТРОЙКИ ==========
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ========== НОВАЯ СТРУКТУРА УСЛУГА + ГОРОД ==========
    RewriteRule ^lending-krasnodar\.html$ /krasnodar/lending/ [R=301,L,NC]
    RewriteRule ^korporativnyj-sajt-krasnodar\.html$ /krasnodar/korporativnyj-sajt/ [R=301,L,NC]
    RewriteRule ^internet-magazin-krasnodar\.html$ /krasnodar/internet-magazin/ [R=301,L,NC]
    RewriteRule ^(krasnodar|moskva|spb|novosibirsk|ekaterinburg)/(lending|korporativnyj-sajt|internet-magazin)/index\.html$ /$1/$2/ [R=301,L,NC]
    RewriteRule ^(krasnodar|moskva|spb|novosibirsk|ekaterinburg)/?$ /$1/$1.html [R=301,L,NC]

    # ========== РЕДИРЕКТЫ УДАЛЁННЫХ СТРАНИЦ (старые) ==========
    # Все /sayt-pod-klyuch-*.html перенаправляем на главную
    RewriteRule ^sayt-pod-klyuch-[^/]+\.html$ / [R=301,L]

    # ========== РЕДИРЕКТЫ УДАЛЁННЫХ СТРАНИЦ В ПАПКАХ ==========
    # Только для удалённых городов (БЕЗ 5 ключевых!)
    RewriteRule ^(kazan|nizhniy-novgorod|chelyabinsk|samara|ufa|rostov-na-donu|omsk|krasnoyarsk|voronezh|perm|volgograd|saratov|tolyatti|tyumen|izhevsk|barnaul|ulyanovsk|irkutsk|khabarovsk|vladivostok|yakutsk)/\1\.html$ / [R=301,L]

    # Редирект для страницы портфолио без канонического адреса
    RewriteRule ^work/krop_rem_avto/index\.html$ /work.html [R=301,L]

    # ========== ЧПУ ДЛЯ ПОРТФОЛИО ==========
    RewriteRule ^portfolio/?$ /work.html [R=301,L]
    RewriteRule ^portfolio/sayty/?$ /work.html?kategory=%D0%A1%D0%B0%D0%B9%D1%82%D1%8B [R=301,L,NE]
    RewriteRule ^portfolio/testirovanie/?$ /work.html?kategory=%D0%A2%D0%B5%D1%81%D1%82%D0%B8%D1%80%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D0%B5 [R=301,L,NE]
    RewriteRule ^portfolio/dizajn/?$ /work.html?kategory=%D0%94%D0%B8%D0%B7%D0%B0%D0%B9%D0%BD [R=301,L,NE]
    RewriteRule ^portfolio/dorabotka/?$ /work.html?kategory=%D0%94%D0%BE%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D0%BA%D0%B0 [R=301,L,NE]

    RewriteRule ^portfolio/prime-estate/?$ /work_info.html?id=1 [R=301,L]
    RewriteRule ^portfolio/objektiv/?$ /work_info.html?id=2 [R=301,L]
    RewriteRule ^portfolio/kinoset/?$ /work_info.html?id=3 [R=301,L]
    RewriteRule ^portfolio/kras-dostavka/?$ /work_info.html?id=4 [R=301,L]
    RewriteRule ^portfolio/krop-rem-avto/?$ /work_info.html?id=5 [R=301,L]
    RewriteRule ^portfolio/sitekrd/?$ /work_info.html?id=6 [R=301,L]

    # ========== AUTO WEBP ==========
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} (.+)\.(png|jpe?g)$
    RewriteCond %1.webp -f
    RewriteRule (.+)\.(png|jpe?g)$ $1.webp [T=image/webp,E=accept:1,L]

</IfModule>

# ========== ЗАГОЛОВКИ ДЛЯ WEBP ==========
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g)$">
        Header append Vary Accept
    </FilesMatch>
    <FilesMatch "\.webp$">
        Header set Content-Type "image/webp"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header always unset X-Powered-By
</IfModule>

# ========== GZIP СЖАТИЕ ==========
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ========== КЕШИРОВАНИЕ БРАУЗЕРА ==========
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

# ========== ЗАГОЛОВКИ КЕШИРОВАНИЯ ==========
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, private"
        Header set Pragma "no-cache"
    </FilesMatch>
    Header unset ETag
</IfModule>

# ========== ОТКЛЮЧАЕМ ETAG ==========
FileETag None

# ========== ЗАЩИТА ЧУВСТВИТЕЛЬНЫХ ФАЙЛОВ ==========
<FilesMatch "(^\.|config\.(local|example)\.php$|\.(env|ini|sql|log|bak|git|md)$)">
    Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off

# ========== КАСТОМНЫЕ СТРАНИЦЫ ОШИБОК ==========
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html
